# ==============================================================================
# InLET Application Environment Configuration
# ==============================================================================
APP_NAME=InLET
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

# ==============================================================================
# SUPABASE DATABASE CONFIGURATION (PILIH SALAH SATU CARA DI BAWAH INI)
# ==============================================================================

# ------------------------------------------------------------------------------
# CARA 1: (PALING MUDAH - 1 BARIS SAJA)
# Ambil dari: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Pilih mode: Transaction Pooler (Port 6543)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# CARA 2: (GUNAKAN KEY SAJA)
# Cukup isi Reference ID dan Password database Supabase Anda:
# - Project Ref ada di URL dashboard: https://supabase.com/dashboard/project/<PROJECT_REF>
# - Password adalah password database yang Anda tentukan saat membuat project Supabase
# ------------------------------------------------------------------------------
# SUPABASE_PROJECT_REF=your_supabase_project_ref_here
# SUPABASE_DB_PASSWORD=your_database_password_here
# SUPABASE_REGION=ap-southeast-1
# SUPABASE_MODE=pooler

# ------------------------------------------------------------------------------
# CARA 3: (MANUAL CONNECTION PARAMETERS)
# ------------------------------------------------------------------------------
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.[PROJECT-REF]
# DB_PASSWORD=your_database_password_here
# DB_SSLMODE=require

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================
ALLOW_ADMIN_RESET=false
