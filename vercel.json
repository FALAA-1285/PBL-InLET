{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/(assets|css|uploads)/(.*)",
      "dest": "/$1/$2",
      "headers": {
        "cache-control": "public, max-age=86400, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/logo.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
